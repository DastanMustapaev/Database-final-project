## Required: main database (PostgreSQL DSN)
## Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/car_rental_db

## Optional: separate DB for tests
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/car_rental_test

## Optional: API bind
APP_HOST=127.0.0.1
APP_PORT=8000

